{
  "name": "nodejs-distroless",
  "version": "0.1.0",
  "description": "NodeJS distroless docker images built with Canonical's Chisel.",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && tsc --project tsconfig.build.json",
    "lint": "eslint . && prettier --check src && tsc --noEmit",
    "dev": "tsx src",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nvitaterna/nodejs-distroless.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/nvitaterna/nodejs-distroless/issues"
  },
  "homepage": "https://github.com/nvitaterna/nodejs-distroless#readme",
  "dependencies": {
    "cheerio": "1.2.0",
    "semver": "7.8.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@faker-js/faker": "10.6.0",
    "@types/node": "26.6.5",
    "@types/semver": "7.8.0",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "msw": "3.0.3",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}