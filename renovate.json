{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Dockerfile$/"
      ],
      "matchStrings": [
        "#\\s*renovate-apt-docker:\\s*?(arch=(?<arch>.*?))?\\s*?(versioning=(?<versioning>.*?))?\\s*depName=(?<depName>.*?)?\\sARG .*?_VERSION=\"(?<currentValue>.*)\""
      ],
      "registryUrlTemplate": "{{#if (equals arch 'amd64')}}https://archive.ubuntu.com/ubuntu{{else}}https://ports.ubuntu.com/ubuntu-ports{{/if}}?suite=resolute&components=universe,multiverse,main,restricted&binaryArch={{arch}}",
      "datasourceTemplate": "deb",
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Dockerfile$/"
      ],
      "matchStrings": [
        "#\\s*renovate-chisel:\\s*depName=(?<depName>.*?)?\\sARG .*?_VERSION=\"(?<currentValue>.*)\""
      ],
      "versioningTemplate": "loose",
      "datasourceTemplate": "custom.github-branches"
    }
  ],
  "packageRules": [
    {
      "description": "Only use Ubuntu LTS releases (YY.04 with an even year), skip short-lived interim releases",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ubuntu"
      ],
      "versioning": "ubuntu",
      "allowedVersions": "/^\\d*[02468]\\.04$/"
    },
    {
      "description": "Only use chisel releases for Ubuntu LTS versions",
      "matchDepNames": [
        "canonical-chisel-releases"
      ],
      "allowedVersions": "/^\\d*[02468]\\.04$/"
    },
    {
      "description": "Automerge non-major updates once all PR checks have passed; majors stay open for review",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "Group non-major GitHub Actions updates into a single PR",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest"
      ],
      "groupName": "GitHub Actions"
    }
  ],
  "platformAutomerge": true,
  "customDatasources": {
    "github-branches": {
      "defaultRegistryUrlTemplate": "https://api.github.com/repos/canonical/chisel-releases/branches",
      "format": "json",
      "transformTemplates": [
        "{ \"releases\": $filter($, function($v) { name[$contains(\"ubuntu\")] }).$map($, function($v) { {\"version\":$v.name.$split('-')[1],\"sourceUrl\":$join([\"https://github.com/canonical/chisel-releases/tree/\",$v.name]),\"digest\":$v.commit.sha} } ),\"homepage\": \"https://github.com/canonical/chisel-releases\" }"
      ]
    }
  }
}
